# The Wandering Clerk settings. On the Yoga laptop these live in
# ~/.config/tavernworks/clerk.env. The Twitch values were GitHub Actions
# secrets (bot) and Val Town env vars (web side) before.

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_BOT_USERNAME=
TWITCH_CHANNEL=

# /admin panel: who may sign in (besides the broadcaster), and the cookie key
ADMIN_USERNAMES=
ADMIN_SESSION_SECRET=

PUBLIC_BASE_URL=https://hunt.tavernworks.dev
PORT=8803
DB_PATH=./data/clerk.sqlite
